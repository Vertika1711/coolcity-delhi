// PHASE 2 SUPPLEMENTARY — Direct radiation, RESAMPLED FIX
// Run only after validation confirms zero nulls.
// ============================================================

var admin2 = ee.FeatureCollection("FAO/GAUL/2015/level2");
var delhi = admin2.filter(ee.Filter.eq('ADM1_NAME', 'Delhi'));
var delhiBounds = delhi.geometry().bounds();
var proj = ee.Projection('EPSG:32643').atScale(2000);
var grid = delhiBounds.coveringGrid(proj);
var delhiGrid = grid.filterBounds(delhi);

var delhiGridWithID = delhiGrid.map(function(feature) {
  return feature.set('cell_id', feature.get('system:index'));
});

function getDirectRadForDate(dateStr) {
  var date = ee.Date(dateStr);

  var hourly = ee.ImageCollection('ECMWF/ERA5/HOURLY')
    .filterDate(date, date.advance(1, 'day'))
    .select([
      'total_sky_direct_solar_radiation_at_surface',
      'mean_surface_direct_short_wave_radiation_flux'
    ]);

  var dailyMean = hourly.mean();

  var resampled = dailyMean
    .resample('bilinear')
    .reproject({crs: 'EPSG:32643', scale: 2000});

  var result = resampled.reduceRegions({
    collection: delhiGridWithID,
    reducer: ee.Reducer.mean(),
    scale: 2000
  });

  result = result.map(function(f) {
    return f.set('date', dateStr);
  });

  return result;
}

function buildYearFC(year) {
  year = ee.Number(year);
  var seasonStart = ee.Date.fromYMD(year, 4, 1);
  var seasonEnd = ee.Date.fromYMD(year, 6, 30);
  var numDays = seasonEnd.difference(seasonStart, 'day');

  var dateList = ee.List.sequence(0, numDays).map(function(dayOffset) {
    return seasonStart.advance(dayOffset, 'day').format('YYYY-MM-dd');
  });

  var yearResults = dateList.map(function(dateStr) {
    return getDirectRadForDate(dateStr);
  });

  return ee.FeatureCollection(yearResults).flatten();
}

var allYears = [2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026];

allYears.forEach(function(year) {
  var yearFC = buildYearFC(year);

  Export.table.toDrive({
    collection: yearFC,
    description: 'CoolCity_DirectRad_Resampled_' + year,
    folder: 'CoolCity_Exports',
    fileNamePrefix: 'coolcity_directrad_resampled_' + year,
    fileFormat: 'CSV',
    selectors: [
      'cell_id', 'date',
      'total_sky_direct_solar_radiation_at_surface',
      'mean_surface_direct_short_wave_radiation_flux'
    ]
  });
});

